# persistent implementation attributes, loaded by normal TD project flow.
# Exact elaborated wide-register names; no custom flow or cached Runs scripts.
set_property IOB FALSE [get_cells -hier {U3/u_phy/pin_do_reg}]
set_property IOB FALSE [get_cells -hier {U3/u_phy/pin_oe_reg}]
set_property IOB FALSE [get_cells -hier {U3/u_phy/pin_ca_reg}]
set_property IOB FALSE [get_cells -hier {U3/u_phy/pin_ba_reg}]
set_property IOB FALSE [get_cells -hier {U3/u_phy/pin_addr_reg}]
set_property IOB TRUE [get_cells -hier {U3/u_phy/d_in_reg}]
set_property dont_touch true [get_cells -hier {U3/u_phy/pin_oe_reg}]
set_property dont_touch true [get_nets -hier {U3/u_phy/pin_oe}]

# independent SW4, HX4S20 manual page18: up=1/down=0.
set_pin_assignment { sw4 } { LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# manufacturer HX4S20 manual page18 SW3=C6, up=1/down=0.
set_pin_assignment { sw3 } { LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# preserve the elaborated three-stage memory reset register cell.
# Native SYN confirms this CELL target binds. Downstream physical replication
# is still possible; final reset topology and all recovery/removal remain audited.
set_property dont_touch true [get_cells -hier {rst_sdram_sync_reg}]

